{
  "manifest_version": 3,
  "name": "FLUX YouTube Link",
  "version": "1.1.0",
  "description": "Links a YouTube tab to FLUX for player framing, captions, and chapter timing.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Link this YouTube tab to FLUX"
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["https://pranav-teja-aluvala.github.io/FLUX/*"]
  },
  "key": "",
  "host_permissions": ["http://127.0.0.1/*"]
}
