{
  "manifest_version": 3,
  "name": "FLUX",
  "description": "A one-click listening view for your YouTube tab, with live artwork, visualizer and synced lyrics.",
  "version": "1.4.4",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "tabCapture", "nativeMessaging"],
  "host_permissions": ["https://lrclib.net/*", "https://i.ytimg.com/*"],
  "action": {
    "default_title": "Open FLUX for this YouTube tab",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
